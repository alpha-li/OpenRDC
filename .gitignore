# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Personal IDE settings are not shared. The one this repository used to carry
# held an absolute path to a CMake source directory, which is wrong on every
# machine but the one that wrote it -- and that machine had moved on too. The
# rest of .vscode stays trackable, so launch.json and tasks.json can still be
# committed if they ever need sharing.
.vscode/settings.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
